{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bytlot-feedback-local",
  "main": "src/local.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:4173",
    "EXPECTED_TURNSTILE_HOSTNAME": "example.com",
    "TURNSTILE_ACTION": "test",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "bytlot-feedback",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
